rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Pozele de profil si fotografiile-amintire stau sub users/{uid}/.
    // Citire si scriere doar de proprietar, ca sa nu vada un cont pozele altuia.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
