rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Pozele de profil si fotografiile-amintire stau sub users/{uid}/.
    // Citire pentru utilizatori autentificati, scriere doar de proprietar.
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
